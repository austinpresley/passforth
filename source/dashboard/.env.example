# Existing Sites deployment defaults to its private identity and D1 database.
DESK_STORAGE=d1
DESK_AUTH_MODE=sites
DESK_READ_ONLY=0

# Independent database and private file storage. Keep the service key server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Independent human sign-in, used only when DESK_AUTH_MODE=supabase.
SUPABASE_PUBLISHABLE_KEY=
DESK_OWNER_EMAIL=
# Preserve the owner value from the original record export.
DESK_OWNER_ID=
# UUID of the confirmed Supabase Auth user, distinct from the legacy record owner.
DESK_AUTH_USER_ID=
# Optional server/agent bearer token, stored as a runtime secret.
DESK_AGENT_TOKEN=
